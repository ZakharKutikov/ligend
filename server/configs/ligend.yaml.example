# Ligend VPN Server Configuration
# Generated by ligend-keygen

# Address to listen on (Go backend, behind nginx)
listen_addr: ":8443"

# Secret WebSocket path (keep secret!)
ws_path: "/ws-change-me"

# Shared secret key (base64, 32 bytes)
# Generate with: ligend-keygen
secret_key: "CHANGE_ME_BASE64_KEY_HERE"

# VPN network subnet
vpn_subnet: "10.8.0.0/24"

# TUN interface name
tun_name: "ligend0"

# MTU for VPN tunnel (1280 is safe for all networks)
mtu: 1280

# DNS servers for VPN clients
dns:
  - "1.1.1.1"
  - "8.8.8.8"

# Path to cover website files
web_root: "./web"

# Traffic padding interval range (seconds)
# Padding frames sent at random intervals within this range
padding_min_sec: 3
padding_max_sec: 15

# Maximum number of simultaneous VPN clients
max_clients: 254
